# Salin ke .env lalu ganti nilainya:  cp .env.example .env
# Wajib diisi agar dashboard bisa diakses dari mesin lain (bukan localhost).
JWT_SECRET=ganti-dengan-string-acak-panjang
INITIAL_PASSWORD=ganti-password-ini
API_KEY_SECRET=ganti-dengan-string-acak-lain
MACHINE_ID_SALT=ganti-dengan-salt-acak

# Opsional
REQUIRE_API_KEY=false
AUTH_COOKIE_SECURE=false
ENABLE_REQUEST_LOGS=false
# URL instance ini dari DALAM container (dipakai job sync internal)
BASE_URL=http://localhost:20128
NEXT_PUBLIC_BASE_URL=http://localhost:20128
# SearXNG di network varkir (provider web-search bawaan)
SEARXNG_URL=http://10.20.0.3:8080/search
# HTTP_PROXY=http://10.20.0.1:7890
# HTTPS_PROXY=http://10.20.0.1:7890
# NO_PROXY=localhost,127.0.0.1,10.20.0.0/24
